{
  "name": "alethes-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // The portal is reachable only at its own address, which sits behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "alethes-portal", "database_id": "01b197bb-e000-4e52-bde4-5c69ad3cde43" }],
  "vars": {
    // Filled in during setup: your Cloudflare Access team address and the portal application's audience tag.
    "TEAM_DOMAIN": "https://alethes-portal.cloudflareaccess.com",
    // Staff-only link shown in the Alethes staff bar. Opens only for alethesfinancial.com Google accounts.
    "TRACKER_URL": "https://script.google.com/a/macros/alethesfinancial.com/s/AKfycbz15HVMymlIETcxxYzIjxcLZV2j4ndWG9AuBR24cUvhLd6v627SuxuN-ZkGkNZ5NWkJ/exec",
    "POLICY_AUD": "3b98fc35eb7d3c6dc2df77a8dd16a3eb95f3a6ebc067c53e94b47f4bed4fd3d5"
  }
}
